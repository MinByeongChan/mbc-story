{
  "name": "dev-blog",
  "version": "1.0.0",
  "homepage": "https://MinByeongChan/minbyeongchan.github.io",
  "type": "module",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "npx --yes serve@latest out",
    "build-stats": "ANALYZE=true npm run build",
    "export": "rimraf dist && cp -R out dist",
    "build-prod": "run-s clean build export",
    "clean": "rimraf .next dist",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mapbox/rehype-prism": "^0.9.0",
    "@mui/icons-material": "^6.2.0",
    "@mui/material": "^6.1.6",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.13",
    "github-markdown-css": "^5.8.1",
    "gray-matter": "^4.0.3",
    "http-proxy-middleware": "^3.0.0",
    "mbc-eslint": "workspace:*",
    "next": "^15.5.14",
    "next-seo": "^6.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-redux": "^7.2.9",
    "react-syntax-highlighter": "^16.1.1",
    "redux": "^4.2.1",
    "redux-logger": "^3.0.6",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "styled-jsx-plugin-postcss": "^4.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.14",
    "@next/eslint-plugin-next": "^15.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.1.0",
    "husky": "^9.1.3",
    "lint-staged": "^15.2.7",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^6.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "license": "ISC",
  "overrides": {
    "prismjs": "^1.30.0"
  }
}
